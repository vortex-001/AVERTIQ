# Environment configuration for AVERTIQ Disaster Intelligence Platform
# Copy this file to .env and adjust variables as required.

PROJECT_NAME=Avertiq
VERSION=1.0.0
API_V1_STR=/api/v1

# Security
SECRET_KEY=avertiq-production-secret-key-disaster-intel-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Default: Local SQLite (zero external dependencies)
DATABASE_URL=sqlite:///./avertiq.db
# PostgreSQL + PostGIS (for docker-compose / production):
# DATABASE_URL=postgresql+psycopg2://avertiq_user:avertiq_password@localhost:5432/avertiq_db

# Default Map Coordinates (Ludhiana, Punjab, India)
DEFAULT_MAP_LAT=30.9010
DEFAULT_MAP_LON=75.8573
DEFAULT_MAP_ZOOM=12
DEFAULT_RADIUS_KM=5.0

# Telegram Bot Integration (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=avertiq-webhook-secret-token

# Gemini AI (Optional - falls back to deterministic rule-based extractor when empty)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# External Hazard Feeds
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
USGS_EARTHQUAKE_FEED_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_day.geojson
GDACS_FEED_URL=https://www.gdacs.org/xml/rss.xml
NASA_FIRMS_API_KEY=

# CORS Configuration
BACKEND_CORS_ORIGINS=["*"]

# Demo Mode (auto-seeds scenario if fresh DB)
DEMO_MODE=true
