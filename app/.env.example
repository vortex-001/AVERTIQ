# ─── Avertiq Viewer App — Environment Configuration ───────────────────────────
#
# Copy this file to .env (git-ignored) and fill in values for your environment.
# Pass values at build time with --dart-define or --dart-define-from-file.
#
# Usage:
#   flutter run \
#     --dart-define=API_BASE_URL=http://10.0.2.2:8000 \
#     --dart-define=WS_BASE_URL=ws://10.0.2.2:8000
#
# ──────────────────────────────────────────────────────────────────────────────

# Base URL of the Avertiq FastAPI backend (no trailing slash)
# Android Emulator → host machine: use 10.0.2.2
# iOS Simulator   → host machine: use 127.0.0.1
# Physical device  → use your machine's LAN IP (e.g. 192.168.1.42)
API_BASE_URL=http://10.0.2.2:8000

# WebSocket base URL (ws:// for dev, wss:// for production TLS)
WS_BASE_URL=ws://10.0.2.2:8000

